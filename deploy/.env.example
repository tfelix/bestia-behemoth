# Copy to .env next to compose.yaml and fill in every value. Secrets: `openssl rand -base64 48`.

# The public name of this host. Players' browsers, the passkeys and the TLS certificate are bound to it, so
# changing it later invalidates every passkey.
BESTIA_HOST=play.bestia.example

# Signs the game tokens: login server issues them, the zone checks them.
GAME_JWT_SECRET=
# Signs the companion app's tokens: login server issues them, the api-server checks them. Must differ from above.
COMPANION_JWT_SECRET=

# Web push keys for the companion app: base64url P-256 key pair, e.g. `npx web-push generate-vapid-keys`.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

BUS_ZONE_PASSWORD=
BUS_API_PASSWORD=
BUS_LOGIN_PASSWORD=

# Optional. Where players' bug reports become issues: a private repo (owner/name) with at least one commit, and a
# fine-grained token for that repo only, with write access to contents and issues. Without both, reports are kept
# in the api-server's database and not published.
#BUG_REPORTS_GITHUB_REPO=
#BUG_REPORTS_GITHUB_TOKEN=
# Optional. Opens the api-server's admin API (bug report bans) to this bearer token, at least 32 characters. The
# proxy does not route it, so it is only reachable as http://api:8095/v1/admin/ on the compose network.
#API_ADMIN_TOKEN=

ZONE_DB_PASSWORD=
LOGIN_DB_PASSWORD=
API_DB_PASSWORD=

# Optional. Lets a language model write the quest texts and epitaphs of a new world, in English and German.
# The first boot then takes much longer: the zone fetches the model (about 5 GB) and waits until the texts are
# written. The host needs about 8 GB of free memory for that time.
#PROSE_ENABLED=true
