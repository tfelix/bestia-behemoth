# Copy to .env next to compose.yaml and fill in every value. Secrets: `openssl rand -base64 48`.

# The public name of this host. Players' browsers, the passkeys and the TLS certificate are bound to it, so
# changing it later invalidates every passkey.
BESTIA_HOST=play.bestia.example

# Signs the game tokens: login server issues them, the zone checks them.
GAME_JWT_SECRET=
# Signs the companion app's tokens: login server issues them, the api-server checks them. Must differ from above.
COMPANION_JWT_SECRET=

# Web push keys for the companion app: base64url P-256 key pair, e.g. `npx web-push generate-vapid-keys`.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

BUS_ZONE_PASSWORD=
BUS_API_PASSWORD=
BUS_LOGIN_PASSWORD=

ZONE_DB_PASSWORD=
LOGIN_DB_PASSWORD=
API_DB_PASSWORD=
