        "definition": "label_values(zone_entities, shard)",
        "query": {
          "query": "label_values(zone_entities, shard)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "regex": ""
      }
    ]
  },
