    {
      "id": 9,
      "type": "timeseries",
      "title": "Jobs waiting per worker",
      "description": "Each worker has a queue of 2048; a job that does not fit is dropped. Jobs for one owner always share a worker, so a hot owner can fill one queue alone.",
