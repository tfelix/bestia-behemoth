    {
      "id": 16,
      "type": "timeseries",
      "title": "Entities by outcome",
      "description": "queued: snapshot taken and queued. written: reached the database. unchanged: a periodic save skipped it. failed and rejected are dropped and written again next time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(zone_persist_entities_total{application=\"zone-server\",shard=~\"$shard\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
