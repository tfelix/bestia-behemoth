        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "zone_db_jobs_pending{application=\"zone-server\",shard=~\"$shard\"}",
          "legendFormat": "worker {{worker}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
