    {
      "id": 9,
      "type": "timeseries",
      "title": "Wait before a handler starts",
      "description": "From a message arriving to its handler starting: behind the same account's earlier messages, then the lane. A tick-lane message also waits for the tick thread to come round to it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, lane) (rate(zone_message_wait_seconds_bucket{application=\"zone-server\",shard=~\"$shard\"}[$__rate_interval])))",
          "legendFormat": "p99 {{lane}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (lane) (rate(zone_message_wait_seconds_sum{application=\"zone-server\",shard=~\"$shard\"}[$__rate_interval])) / sum by (lane) (rate(zone_message_wait_seconds_count{application=\"zone-server\",shard=~\"$shard\"}[$__rate_interval]))",
          "legendFormat": "mean {{lane}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
