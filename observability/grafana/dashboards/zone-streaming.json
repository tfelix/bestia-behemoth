    {
      "id": 4,
      "type": "timeseries",
      "title": "Budgets used per tick",
      "description": "Slab computations, derived rebuilds, encodes and request tokens spent per tick. Compare each with its limit in chunk-stream.*.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (budget) (rate(zone_chunk_budget_spent_total{application=\"zone-server\",shard=~\"$shard\"}[$__rate_interval])) / scalar(sum(rate(zone_tick_duration_seconds_count{part=\"total\",application=\"zone-server\",shard=~\"$shard\"}[$__rate_interval])))",
          "legendFormat": "{{budget}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
