    {
      "id": 2,
      "type": "timeseries",
      "title": "Heap",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (id) (jvm_memory_used_bytes{application=~\"$application\",area=\"heap\"})",
          "legendFormat": "used {{id}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(jvm_memory_committed_bytes{application=~\"$application\",area=\"heap\"})",
          "legendFormat": "committed"
