    {
      "id": 15,
      "type": "timeseries",
      "title": "Netty memory",
      "description": "What the socket layer holds, direct buffers included, which the heap graph does not show. Steady growth is a leak or clients that do not read.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (memory_type) (netty_allocator_memory_used{application=\"zone-server\"})",
          "legendFormat": "{{memory_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
